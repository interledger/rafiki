---
import Pagination from '@astrojs/starlight/components/Pagination.astro'
import DpgBadge from './DpgBadge.astro'
---

<footer class='footer sl-flex'>
  <Pagination />
  <div class='footer-legal'>
    <a
      class='dpg-link'
      href='https://www.digitalpublicgoods.net/r/rafiki'
      rel='noopener noreferrer'
      target='_blank'
      data-umami-event='Rafiki docs footer - DPG registry'
    >
      <DpgBadge class='dpg-badge' />
      <span>Rafiki is a verified digital public good.</span>
    </a>
    <p>
      Rafiki is stewarded by the <a
        href='https://interledger.org'
        rel='noopener noreferrer'
        target='_blank'
        data-umami-event='Rafiki docs footer - Interledger foundation'
        >Interledger Foundation</a
      > and Rafiki contributors.
    </p>
    <p>
      Rafiki is made available by the Interledger Foundation under the <a
        href='https://github.com/interledger/rafiki/blob/main/LICENSE'
        rel='noopener noreferrer'
        target='_blank'
        data-umami-event='Rafiki docs footer - Apache Licence'
        >Apache License, Version 2.0.</a
      >
    </p>
  </div>
</footer>

<style>
  .footer {
    flex-grow: 1;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 6rem;
  }

  .footer-legal {
    margin-top: auto;
    padding: 1rem;
    color: #676767;
    text-align: center;
    font-size: var(--sl-text-sm);
  }

  .footer-legal a:hover {
    color: var(--sl-color-white);
  }

  .dpg-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xs);
    color: inherit;
    text-decoration: none;
  }

  .dpg-link:hover span {
    text-decoration: underline;
  }

  .dpg-link :global(.dpg-badge) {
    width: 4.5rem;
    flex: none;
  }
</style>
